    "def malthus_taux(y0 : float,a : float, t_max: float, nbPoints : int) -> int :\n",
    "    t = np.linspace(0, t_max, nbPoints)\n",
    "    y = y0 * np.exp(a*t)\n",
    "    return t,y"
   ]
  },
