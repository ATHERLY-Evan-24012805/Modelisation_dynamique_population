    "def malthus ( population :int, iterations : int ) -> list :\n",
    "    historique = [population]\n",
    "    for i in range(iterations) :\n",
    "        population = 2 * population\n",
    "        historique.append(population)\n",
    "    return historique\n"
   ]
  },
