    "def malthus_taux2 (y0, a, t_max, nbPoints) :\n",
    "    pas = t_max / (nbPoints - 1)\n",
    "    t = []\n",
    "    y = [y0]\n",
    "    for i in range (nbPoints) :\n",
    "        t.append(i*pas)\n",
    "\n",
    "    for j in range(len(t)):\n",
    "        y_new = y[0] * np.exp(a*t[j])\n",
    "        y.append(y_new)\n",
    "\n",
    "    y.pop()\n",
    "    return t, y"
   ]
  },
